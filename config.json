{
    "port": 9150,
    "address": "0.0.0.0",
    "rootFolder": "./tmp/uploads/images",
    "allowGifs": true,
    "signingKey": {
        "type": "file",
        "value": "./key"
    },
    "database": {
        "dbType": "sqlite",
        "dbAddress": "./images.db",
        "dbPort": 5432,
        "dbSSL": "disable",
        "dbLogin": "imserver",
        "dbPassword": "imserver",
        "dbName": "imserver"
    },
    "compression": {
        "useCompression": true,
        "compLevel": 2
    },
    "caching": {
        "useCache": true,
        "expirCache": 30,
        "whitelistTypes": [
            "application/json",
            "text/plain"
        ]
    },
    "logger": {
        "logMode": "dev",
        "logRequests": true
    },
    "rateLimiter": {
        "enable": true,
        "whiteListedIPs": [],
        "maxRecConns": 20,
        "expirTimeMin": 2
    }
}